<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Checkstyle configuration for TaskFlow API.
    Based on Google Java Style Guide with minor adjustments
    for Spring Boot projects.
    https://google.github.io/styleguide/javaguide.html
-->
<module name="Checker">

    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <!-- ── File-level checks ──────────────────────────── -->

    <!-- No tab characters — use spaces only -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- Files must end with a newline -->
    <module name="NewlineAtEndOfFile"/>

    <!-- Max line length: 120 characters -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <!-- Ignore long import statements and URLs in comments -->
        <property name="ignorePattern" value="^import .*|.*https?://.*"/>
    </module>

    <!-- ── Suppressions ───────────────────────────────── -->

    <!-- Rule exemptions scoped to a source tree, see the file itself for the
         reason of each one. Declared on Checker and not on TreeWalker: a
         SuppressionFilter placed inside TreeWalker would only reach the rules
         TreeWalker owns, leaving the file-level checks above it unfilterable.
         ${config_loc} is set by the Gradle Checkstyle plugin to the value of
         its configDirectory property, config/checkstyle by default. Writing
         the path relative to the project root instead would break as soon as
         the task runs from another working directory. -->
    <module name="SuppressionFilter">
        <property name="file" value="${config_loc}/suppressions.xml"/>
        <!-- optional=false — a missing suppression file fails the build rather
             than silently applying every rule everywhere. A filter that
             disappears without a sound is how an exemption becomes a surprise
             on someone else's branch. -->
        <property name="optional" value="false"/>
    </module>

    <module name="TreeWalker">

        <!-- ── Naming conventions ─────────────────────── -->

        <!-- Class names: UpperCamelCase -->
        <module name="TypeName"/>

        <!-- Method names: lowerCamelCase -->
        <module name="MethodName"/>

        <!-- Variable names: lowerCamelCase -->
        <module name="LocalVariableName"/>

        <!-- Parameter names: lowerCamelCase -->
        <module name="ParameterName"/>

        <!-- Constants: UPPER_SNAKE_CASE -->
        <module name="ConstantName"/>

        <!-- Package names: lowercase -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>

        <!-- ── Imports ────────────────────────────────── -->

        <!-- No wildcard imports (e.g. import java.util.*) -->
        <module name="AvoidStarImport"/>

        <!-- No unused imports -->
        <module name="UnusedImports"/>

        <!-- No redundant imports -->
        <module name="RedundantImport"/>

        <!-- ── Whitespace ─────────────────────────────── -->

        <!-- Space after keywords (if, for, while, etc.) -->
        <module name="WhitespaceAfter"/>

        <!-- No whitespace before semicolons and commas -->
        <module name="NoWhitespaceBefore"/>

        <!-- ── Braces ─────────────────────────────────── -->

        <!-- Always use braces, even for single-line blocks -->
        <module name="NeedBraces"/>

        <!-- Opening brace on same line as declaration -->
        <module name="LeftCurly"/>

        <!-- Closing brace on its own line -->
        <module name="RightCurly"/>

        <!-- ── Code quality ───────────────────────────── -->

        <!-- No empty blocks -->
        <module name="EmptyBlock">
            <property name="option" value="text"/>
        </module>

        <!-- No empty catch blocks without a comment -->
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignored"/>
        </module>

        <!-- equals() and hashCode() must be overridden together -->
        <module name="EqualsHashCode"/>

        <!-- No magic numbers — use named constants -->
        <!-- Ignores common values: -1, 0, 1, 2 and annotation values -->
        <module name="MagicNumber">
            <property name="ignoreNumbers" value="-1, 0, 1, 2"/>
            <property name="ignoreAnnotation" value="true"/>
            <property name="ignoreHashCodeMethod" value="true"/>
        </module>

        <!-- No System.out.println — use a logger -->
        <module name="Regexp">
            <property name="format" value="System\.out\.println"/>
            <property name="illegalPattern" value="true"/>
            <property name="message" value="Use a logger instead of System.out.println"/>
        </module>

        <!-- Track TODO comments without blocking the build -->
        <module name="TodoComment">
            <property name="format" value="TODO:"/>
        </module>

        <!-- Max method length: 50 lines -->
        <module name="MethodLength">
            <property name="max" value="50"/>
        </module>

        <!-- ParameterNumber removed on 21 August 2026 (#75).
            The rule belongs to sun_checks.xml and is absent from google_checks.xml,
            the style this project formats against through google-java-format. Its
            purpose is call-site readability: a call with nine positional arguments
            is unreadable and misordering same-typed arguments is easy. That harm
            does not exist for an injection constructor, which Spring resolves by
            type and which no one ever calls by hand.
            The dependency count remains a design signal, but it makes a poor
            blocking gate: the usual way past such a gate is a parameter object,
            which changes nothing about the design it was meant to flag.
            The signal itself has been acted on separately. UserService establishes
            sessions and manages accounts, two responsibilities that belong in
            separate services. The split is recorded in the pending items of
            avancement-api.md and deferred to after November 2026; SECURITY.md and
            the class Javadoc state the separation is partial, rather than claiming
            it is applied. -->

        <!-- ── Javadoc ────────────────────────────────── -->

        <!-- Javadoc required on public methods -->
        <!-- Ignore test methods — their name describes their intent -->
        <module name="MissingJavadocMethod">
            <property name="scope" value="public"/>
            <property name="allowMissingPropertyJavadoc" value="true"/>
            <property name="ignoreMethodNamesRegex" value="^(test|should|given|when|then).*$"/>
        </module>

    </module>

</module>
