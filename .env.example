# .env.example — template for LOCAL DEVELOPMENT configuration
# Copy this file to .env and fill in your local values before running the
# application. This file IS committed to the repository — it contains no secrets.
#
# Production is configured elsewhere. Its .env belongs to the taskflow-deploy
# repository, alongside the compose file that consumes it, and the prod profile
# additionally reads two secrets from files mounted by Docker rather than from
# any variable listed here. Following this template to deploy would produce an
# application that refuses to start.

# JWT
# Generate a secure random secret: openssl rand -hex 64
#
# Local development only. The prod profile does NOT read this variable: it reads
# /run/secrets/jwt.secret, a file mounted by Docker, so that the signing key never
# appears in `docker inspect`.
JWT_SECRET=your-secret-key-must-be-at-least-32-characters-long-change-this

# JWT expiration in milliseconds — 900000 = 15 minutes
JWT_EXPIRATION=900000

# false in local development — cookies transmitted over HTTP on localhost
COOKIE_SECURE=false

# Refresh token validity in days
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Database
# localhost — MySQL running directly on the host machine in development.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=taskflow
DB_USERNAME=your-db-username
# Local development only, same as JWT_SECRET above: the prod profile reads
# /run/secrets/db.password instead. DB_USERNAME stays a plain variable, a user
# name being no credential on its own.
DB_PASSWORD=your-db-password
